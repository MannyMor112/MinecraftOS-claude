# MinecraftOS build configuration. Everything that affects the output is pinned here.
MCOS_VERSION="v1"
DEBIAN_SUITE="trixie"
# Debian snapshot = frozen archive state, so rebuilds get identical package versions.
SNAPSHOT="20261118T000000Z"
MIRROR="https://snapshot.debian.org/archive/debian/${SNAPSHOT}"
# Java 8 runtime (Eclipse Temurin, GPLv2+Classpath Exception, redistributable)
JAVA_URL="https://github.com/adoptium/temurin8-binaries/releases/download/jdk8u512-b09/OpenJDK8U-jre_x64_linux_hotspot_8u512b09.tar.gz"
JAVA_SHA256="57468dc8bfd71dd0578d9717e63a8c13b9efe0a2f2c85c2a13966d1c0f9b1e5f"
