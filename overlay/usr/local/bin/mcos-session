#!/bin/bash
# Login session on tty1 (autologin user 'mc'). Boot mode comes from the GRUB entry (mcos.mode=).
. /usr/local/lib/mcos/common.sh
export TERM=linux
setterm --blank 0 --powerdown 0 2>/dev/null
clear
echo "MinecraftOS $MCOS_VERSION"
/usr/local/lib/mcos/prism-setup.sh

ready() {
  grep -qs '"type": *"MSA"' "$PRISM_DIR/accounts.json" &&
  [ -s "$PRISM_DIR/instances/$INSTANCE/libraries/OptiFine-1.8.9_HD_U_M5.jar" ]
}
export -f ready 2>/dev/null

ready || mcos-firstrun

case "$(cmdline mode play)" in
  play)  ready && mcos-play ;;
  bench) ready && { mcos-bench; pause "Benchmark done. Press Enter for the menu..."; } ;;
  suite) ready && { mcos-bench-suite "$(cmdline repeats 2)"; pause "Suite done. Press Enter for the menu..."; } ;;
  menu)  : ;;
esac
while true; do mcos-menu; done
