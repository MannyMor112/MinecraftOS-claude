[Unit]
Description=MinecraftOS data partition (grow on first boot, mount at /data)
DefaultDependencies=no
After=local-fs-pre.target systemd-udev-settle.service
Wants=systemd-udev-settle.service
Before=getty@tty1.service
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/mcos/data.sh
TimeoutStartSec=600
[Install]
WantedBy=multi-user.target
